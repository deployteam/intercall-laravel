{
  "name": "deployteam/intercall-laravel",
  "description": "Laravel adapter for Intercall - event-based inter-system communication",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "laravel",
    "microservices",
    "inter-system",
    "communication",
    "redis",
    "messagepack",
    "intercall"
  ],
  "authors": [
    {
      "name": "DeployTeam",
      "email": "hello@deploy.com.ro"
    }
  ],
  "require": {
    "php": "^8.2",
    "deployteam/intercall": "^0.11.0",
    "illuminate/console": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/redis": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "spatie/laravel-package-tools": "^1.93.1"
  },
  "require-dev": {
    "brianium/paratest": "^7.8.5",
    "ergebnis/composer-normalize": "^2.52.0",
    "ergebnis/phpstan-rules": "^2.13.1",
    "mockery/mockery": "^1.6.12",
    "orchestra/testbench": "^8.0 || ^9.0 || ^10.7 || ^11.1",
    "php-cs-fixer/shim": "^3.95.10",
    "phpstan/phpstan": "^2.2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0.4",
    "phpstan/phpstan-mockery": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0.11",
    "phpunit/phpunit": "^11.5.55",
    "predis/predis": "^2.4.1",
    "rector/rector": "^2.5.2",
    "slevomat/coding-standard": "^8.29",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "squizlabs/php_codesniffer": "^4.0.1",
    "thecodingmachine/phpstan-safe-rule": "^1.4.4"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "DeployTeam\\IntercallLaravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DeployTeam\\IntercallLaravel\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false,
      "ergebnis/composer-normalize": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "DeployTeam\\IntercallLaravel\\IntercallLaravelServiceProvider"
      ]
    }
  },
  "scripts": {
    "lint": [
      "composer audit --ansi",
      "composer normalize --ansi --diff --no-check-lock --dry-run",
      "composer validate",
      "@rector",
      "@phpcsfixer",
      "@phpcs",
      "@ide-helper",
      "@phpstan"
    ],
    "lint:baseline": [
      "@phpstan:baseline"
    ],
    "lint:clean": [
      "rm -rf vendor",
      "@lint:clear-cache",
      "composer install",
      "@lint:fix",
      "@lint"
    ],
    "lint:clear-cache": "rm -rf .tools/cache",
    "lint:fix": [
      "composer normalize --ansi --diff --no-check-lock",
      "@rector:fix",
      "@phpcsfixer:fix",
      "@phpcs:fix"
    ],
    "phpcs": "phpcs",
    "phpcs:fix": "phpcbf",
    "phpcsfixer": "@phpcsfixer:fix --dry-run",
    "phpcsfixer:fix": "php-cs-fixer fix --ansi --verbose --diff",
    "phpstan": "vendor/bin/phpstan --ansi --memory-limit=4G",
    "phpstan:baseline": "@phpstan --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
    "rector": "@rector:fix --dry-run",
    "rector:fix": "vendor/bin/rector process --ansi",
    "test": "paratest --testdox --colors=always",
    "test:no-coverage": "@test --no-coverage"
  }
}
